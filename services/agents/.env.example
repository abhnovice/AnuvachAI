# ==========================================
# Anuvach.AI Backend & Agent Configuration
# ==========================================
NODE_ENV=production
HOST=0.0.0.0
PORT=8080

# Storage Backend: "sqlite" (local dev) | "firestore" (hosted demo)
STORAGE_BACKEND=firestore
SQLITE_PATH=services/api/anuvach.sqlite
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
FIRESTORE_DATABASE_ID=(default)

# Access Control (Strict 2-User Allowlist)
FIREBASE_PROJECT_ID=your-gcp-project-id
ALLOWED_USER_EMAILS=you@example.com,partner@example.com
ADMIN_USER_EMAILS=you@example.com

# Private Local A2A Connection (Inside Single Cloud Run Container)
A2A_AGENT_URL=http://127.0.0.1:8000
A2A_SHARED_SECRET=replace-with-random-32-char-hex

# Gemini API (Server-Side Only - Stored in Secret Manager)
GEMINI_API_KEY=replace-with-ai-studio-free-tier-key
GEMINI_MODEL=gemini-2.5-flash

# Feature Flags (Keep Voice Disabled for Cost & Reliability)
ENABLE_VOICE=false

# ==========================================
# Stage 4 Future Placeholder: AlloyDB Express RAG
# (Keep RAG_ENABLED=false until ready to prototype)
# ==========================================
RAG_ENABLED=false
ALLOYDB_HOST=127.0.0.1
ALLOYDB_PORT=5432
ALLOYDB_DATABASE=anuvach_rag
ALLOYDB_USER=postgres
ALLOYDB_PASSWORD=placeholder-set-via-secret-manager
ALLOYDB_INSTANCE_URI=projects/your-gcp-project-id/locations/asia-south1/clusters/anuvach-cluster/instances/anuvach-primary
ALLOYDB_EMBEDDING_MODEL=text-embedding-004
