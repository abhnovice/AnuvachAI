# Copy to .env and enter your Google AI Studio key locally.
GOOGLE_API_KEY=
REPORTING_TEXT_MODEL=gemini-3.5-flash-lite
REPORTING_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
TRIAGE_MODEL=gemini-3.5-flash-lite
TRIAGE_PROVIDER=synthetic
A2A_HOST=127.0.0.1
A2A_PORT=8011
WORKBENCH_HOST=127.0.0.1
WORKBENCH_PORT=8000
TRIAGE_AGENT_CARD_URL=http://127.0.0.1:8011/.well-known/agent-card.json
AGENTS_DB_PATH=data/agents.sqlite
